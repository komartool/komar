# before carries call.args, after carries ret and duration, exception carries the exception which the program still sees; void callees have no ret; this is the caller and call.target the receiver
exec javac --release 8 -Xlint:-options -g -d classes Main.java
exec java -cp classes Main
cp stdout base.txt
exec komar run spec.yaml -o out.jsonl -- java -cp classes Main
cmp stdout base.txt
jsonl-norm -duration duration out.jsonl got.jsonl
cmp got.jsonl expected.jsonl

-- Main.java --
public class Main {
    static class Gateway {
        private final String name = "gw";

        String send(String msg, int n) {
            if (n < 0) {
                throw new IllegalStateException("negative " + n);
            }
            return msg + n;
        }

        void log(String msg) {
        }
    }

    private final String id = "billing";
    private final Gateway gateway = new Gateway();

    String charge(String call, int n) {
        gateway.log(call);
        return gateway.send(call, n);
    }

    public static void main(String[] args) {
        Main m = new Main();
        System.out.println(m.charge("a", 1));
        try {
            m.charge("b", -1);
        } catch (IllegalStateException e) {
            System.out.println("caught " + e.getMessage());
        }
    }
}
-- spec.yaml --
probes:
  - id: send
    where: { class: Main, method: charge, call: { class: 'Main$Gateway', method: send } }
    what:
      - call.args
      - ret
      - err: exception.message
      - duration
  - id: roles
    where: { class: Main, method: charge, call: { class: 'Main$Gateway', method: send }, at: [before] }
    what:
      - caller: this.id
      - receiver: call.target.name
      - program_call: vars.call
  - id: void
    where: { class: Main, method: charge, call: { class: 'Main$Gateway', method: log }, at: [after] }
    what: [ret, call.args]
-- expected.jsonl --
