# lines inside lambdas, nested lambdas, anonymous classes and local classes loaded later belong to the method; records name the method that ran and the enclosing one
exec javac --release 8 -Xlint:-options -g -d classes Main.java
exec komar run spec.yaml -o out.jsonl -- java -cp classes Main
jsonl-norm out.jsonl got.jsonl
cmp got.jsonl expected.jsonl

-- Main.java --
import java.util.Arrays;
import java.util.List;

public class Main {
    static void handle(List<Integer> xs) {
        xs.forEach(x -> {
            int sq = x * x;
            xs.stream().filter(y -> {
                int d = y - x;
                return d > 0;
            }).count();
        });
        Runnable r = new Runnable() {
            @Override
            public void run() {
                int inner = 7;
            }
        };
        r.run();
        class Later {
            int value(int v) {
                int doubled = v * 2;
                return doubled;
            }
        }
        new Later().value(5);
    }

    static void other() {
        Runnable r = () -> {
            int unrelated = 1;
        };
        r.run();
    }

    public static void main(String[] args) {
        handle(Arrays.asList(1, 2));
        other();
    }
}
-- spec.yaml --
probes:
  - id: lambda
    where: { class: Main, method: handle, line: [7] }
    what:
      - x: vars.x
      - sq: vars.sq
  - id: nested
    where: { class: Main, method: handle, line: [9] }
    what:
      - y: vars.y
      - x: vars.x
  - id: anon
    where: { class: Main, method: handle, line: [16] }
    what:
      - inner: vars.inner
  - id: local
    where: { class: Main, method: handle, line: [22] }
    what:
      - doubled: vars.doubled
      - v: vars.v
  - id: not_other
    where: { class: Main, method: handle, line: [31] }
