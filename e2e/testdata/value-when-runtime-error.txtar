# a when that fails at run time counts as false, is reported once with where it first failed, and is counted per probe in end; a guarded condition never fails
exec javac --release 8 -Xlint:-options -parameters -d classes Main.java
exec komar run spec.yaml -o out -- java -cp classes Main
jsonl-norm out.jsonl got.jsonl
cmp got.jsonl expected.jsonl

-- Main.java --
public class Main {
    static class Customer {
        private final boolean vip;

        Customer(boolean vip) {
            this.vip = vip;
        }
    }

    static class Order {
        private final long id;
        private final Customer customer;

        Order(long id, Customer customer) {
            this.id = id;
            this.customer = customer;
        }
    }

    static void charge(Order order) {
    }

    public static void main(String[] args) {
        charge(new Order(1, null));
        charge(new Order(2, new Customer(true)));
        charge(new Order(3, null));
        charge(new Order(4, new Customer(false)));
    }
}
-- spec.yaml --
probes:
  - id: vip
    where: { class: Main, method: charge, at: [entry] }
    when: 'vars.order.customer.vip'
    what:
      - id: vars.order.id
  - id: guarded
    where: { class: Main, method: charge, at: [entry] }
    when: 'has(vars.order.customer) && vars.order.customer.vip'
    what:
      - id: vars.order.id
  - id: ternary
    where: { class: Main, method: charge, at: [entry] }
    when: 'vars.order.customer != null ? !vars.order.customer.vip : true'
    what:
      - id: vars.order.id
-- expected.jsonl --
{"kind":"run","format":1,"komar":"<masked>","spec":"spec.yaml","cmd":["java","-cp","classes","Main"],"start":"<masked>"}
