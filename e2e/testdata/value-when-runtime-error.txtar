{"kind":"diag","level":"info","probe":"guarded","msg":"placed","class":"Main","methods":1,"pid":1}
{"kind":"diag","level":"info","probe":"ternary","msg":"placed","class":"Main","methods":1,"pid":1}
{"kind":"diag","level":"warn","probe":"vip","msg":"when failed: cannot read field 'vip' of null or of a plain value; counted as false","first_at":{"method":"Main.charge(Order)","thread":"main"},"pid":1}
{"kind":"hit","probe":"ternary","point":"entry","method":"Main.charge(Order)","call":1,"parent":null,"thread":{"id":1,"name":"main"},"pid":1,"ts":"<masked>","what":{"id":1}}
{"kind":"hit","probe":"vip","point":"entry","method":"Main.charge(Order)","call":2,"parent":null,"thread":{"id":1,"name":"main"},"pid":1,"ts":"<masked>","what":{"id":2}}
{"kind":"hit","probe":"guarded","point":"entry","method":"Main.charge(Order)","call":2,"parent":null,"thread":{"id":1,"name":"main"},"pid":1,"ts":"<masked>","what":{"id":2}}
{"kind":"hit","probe":"ternary","point":"entry","method":"Main.charge(Order)","call":3,"parent":null,"thread":{"id":1,"name":"main"},"pid":1,"ts":"<masked>","what":{"id":3}}
{"kind":"hit","probe":"ternary","point":"entry","method":"Main.charge(Order)","call":4,"parent":null,"thread":{"id":1,"name":"main"},"pid":1,"ts":"<masked>","what":{"id":4}}
{"kind":"end","reason":"exit","code":0,"hits":{"guarded":1,"ternary":3,"vip":1},"dropped":0,"when_errors":{"vip":2}}
