# what items are CEL expressions over fields: paths, arithmetic, strings, macros, has; a failing item becomes @error and the hit is still written
exec javac --release 8 -Xlint:-options -parameters -d classes Main.java
exec java -cp classes Main
cp stdout base.txt
exec komar run spec.yaml -o out -- java -cp classes Main
cmp stdout base.txt
jsonl-norm out.jsonl got.jsonl
cmp got.jsonl expected.jsonl

-- Main.java --
import java.util.Arrays;
import java.util.List;

public class Main {
    static class Item {
        private final String sku;
        private final double price;
        private final int qty;

        Item(String sku, double price, int qty) {
            this.sku = sku;
            this.price = price;
            this.qty = qty;
        }
    }

    static class Customer {
        private final String name;

        Customer(String name) {
            this.name = name;
        }
    }

    static class Order {
        private final Customer customer;
        private final List<Item> items;
        private final int[] codes = {3, 4};

        Order(Customer customer, List<Item> items) {
            this.customer = customer;
            this.items = items;
        }

        public Customer getCustomer() {
            System.out.println("getter ran");
            return customer;
        }
    }

    static void ship(Order order) {
    }

    public static void main(String[] args) {
        ship(new Order(new Customer("ann"), Arrays.asList(new Item("A-1", 2.5, 4), new Item("B-2", 10.0, 1))));
        ship(new Order(null, Arrays.asList(new Item("C-3", 1.0, 1))));
        System.out.println("done");
    }
}
-- spec.yaml --
probes:
  - id: ship
    where: { class: Main, method: ship, at: [entry] }
    what:
      - name: vars.order.customer.name
      - greeting: '"hi " + vars.order.customer.name'
      - has_customer: has(vars.order.customer)
      - count: size(vars.order.items)
      - skus: vars.order.items.map(i, i.sku)
      - first_total: vars.order.items[0].price * double(vars.order.items[0].qty)
      - any_big: vars.order.items.exists(i, i.price > 5.0)
      - codes: vars.order.codes
      - second_code: vars.order.codes[1]
      - mixed: vars.order.items[0].price * 2
      - out_of_range: args[5]
      - missing_field: vars.order.nosuch
-- expected.jsonl --
{"kind":"run","format":1,"komar":"<masked>","spec":"spec.yaml","cmd":["java","-cp","classes","Main"],"start":"<masked>"}
{"kind":"diag","level":"info","msg":"agent started","jvm":"<masked>","pid":1}
{"kind":"diag","level":"info","probe":"ship","msg":"placed","class":"Main","methods":1,"pid":1}
{"kind":"hit","probe":"ship","point":"entry","method":"Main.ship(Order)","call":1,"parent":null,"thread":{"id":1,"name":"main"},"pid":1,"ts":"<masked>","what":{"name":"ann","greeting":"hi ann","has_customer":true,"count":2,"skus":["A-1","B-2"],"first_total":10.0,"any_big":true,"codes":[3,4],"second_code":4,"mixed":{"@error":"No matching overload for function '_*_'. Overload candidates: multiply_int64; int and double do not mix in arithmetic: write 2.0 instead of 2, or wrap a value in double()"},"out_of_range":{"@error":"Index out of bounds: 5"},"missing_field":{"@error":"no field 'nosuch' in Main$Order"}}}
{"kind":"hit","probe":"ship","point":"entry","method":"Main.ship(Order)","call":2,"parent":null,"thread":{"id":1,"name":"main"},"pid":1,"ts":"<masked>","what":{"name":{"@error":"cannot read field 'name' of null or of a plain value"},"greeting":{"@error":"cannot read field 'name' of null or of a plain value"},"has_customer":false,"count":1,"skus":["C-3"],"first_total":1.0,"any_big":false,"codes":[3,4],"second_code":4,"mixed":{"@error":"No matching overload for function '_*_'. Overload candidates: multiply_int64; int and double do not mix in arithmetic: write 2.0 instead of 2, or wrap a value in double()"},"out_of_range":{"@error":"Index out of bounds: 5"},"missing_field":{"@error":"no field 'nosuch' in Main$Order"}}}
{"kind":"end","reason":"exit","code":0,"hits":{"ship":2},"dropped":0,"when_errors":{}}
