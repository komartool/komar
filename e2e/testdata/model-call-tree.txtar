# parent is the nearest probed call on the same thread, unprobed methods are skipped, recursion nests, each thread starts its own tree
exec javac --release 8 -Xlint:-options -d classes Main.java
exec komar run spec.yaml -o out.jsonl -- java -cp classes Main
jsonl-norm out.jsonl got.jsonl
cmp got.jsonl expected.jsonl

-- Main.java --
public class Main {
    static void handle() {
        load();
        query("b");
    }

    static void load() {
        query("a");
    }

    static void query(String q) {
    }

    static int fact(int n) {
        return n <= 1 ? 1 : n * fact(n - 1);
    }

    public static void main(String[] args) throws Exception {
        handle();
        fact(3);
        Thread worker = new Thread(Main::handle, "worker");
        worker.start();
        worker.join();
    }
}
-- spec.yaml --
probes:
  - id: handle
    where: { class: Main, method: handle, at: [entry, exit] }
  - id: query
    where: { class: Main, method: query, at: [entry] }
    what: [args]
  - id: fact
    where: { class: Main, method: fact, at: [exit] }
    what: [args, ret]
-- expected.jsonl --
