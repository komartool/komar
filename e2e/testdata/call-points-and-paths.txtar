# at selects points; a call in a loop writes one pair per iteration; two calls to one callee each write records; a checked exception caught by the caller is recorded and the caller exits normally
exec javac --release 8 -Xlint:-options -d classes Main.java
exec java -cp classes Main
cp stdout base.txt
exec komar run spec.yaml -o out.jsonl -- java -cp classes Main
cmp stdout base.txt
jsonl-norm out.jsonl got.jsonl
cmp got.jsonl expected.jsonl

-- Main.java --
import java.io.IOException;

public class Main {
    static int check(int x) throws IOException {
        if (x < 0) {
            throw new IOException("bad " + x);
        }
        return x * 10;
    }

    static int run(int[] xs) {
        int total = 0;
        for (int x : xs) {
            try {
                total += check(x);
            } catch (IOException e) {
                total -= 1;
            }
        }
        try {
            total += check(5);
        } catch (IOException e) {
            total = 0;
        }
        return total;
    }

    public static void main(String[] args) {
        System.out.println(run(new int[] {1, -2}));
    }
}
-- spec.yaml --
probes:
  - id: before_only
    where: { class: Main, method: run, call: { class: Main, method: check }, at: [before] }
    what: [call.args]
  - id: after_only
    where: { class: Main, method: run, call: { class: Main, method: check }, at: [after] }
    what: [ret]
  - id: exception_only
    where: { class: Main, method: run, call: { class: Main, method: check }, at: [exception] }
    what:
      - err: exception.message
  - id: caller
    where: { class: Main, method: run, at: [exit] }
    what: [ret]
-- expected.jsonl --
