# locals appear only while in scope; catch lines fire only when caught; finally lines fire on both paths; static methods have no this; constructor lines see this after super()
exec javac --release 8 -Xlint:-options -g -d classes Main.java
exec komar run spec.yaml -o out.jsonl -- java -cp classes Main
jsonl-norm out.jsonl got.jsonl
cmp got.jsonl expected.jsonl

-- Main.java --
public class Main {
    private final String name;

    Main(String name) {
        int len = name.length();
        this.name = name;
    }

    static String risky(int x) {
        String result = "start";
        try {
            if (x < 0) {
                throw new IllegalStateException("neg");
            }
            result = "ok";
        } catch (IllegalStateException e) {
            result = "caught " + e.getMessage();
        } finally {
            result = result + "!";
        }
        if (x > 100) {
            int big = x;
            result = result + big;
        }
        return result;
    }

    public static void main(String[] args) {
        new Main("ab");
        risky(1);
        risky(-1);
        risky(200);
    }
}
-- spec.yaml --
probes:
  - id: ctor
    where: { class: Main, method: new, line: [5, 6] }
    what:
      - len: vars.len
      - name: vars.name
      - this
  - id: catch
    where: { class: Main, method: risky, line: [17] }
    what:
      - x: vars.x
      - e: vars.e.message
  - id: finally
    where: { class: Main, method: risky, line: [19] }
    what:
      - x: vars.x
      - result: vars.result
  - id: scope
    where: { class: Main, method: risky, line: [21, 23, 25] }
    what:
      - big: vars.big
      - this
