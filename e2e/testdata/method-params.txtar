# params select overloads: none = all, qualified, simple names, ambiguous simple names, empty, primitive vs boxed, arrays, generics, varargs, type variables, no match
exec javac --release 8 -Xlint:-options -d classes Main.java
exec komar run spec.yaml -o out.jsonl -- java -cp classes Main
jsonl-norm out.jsonl got.jsonl
cmp got.jsonl expected.jsonl

-- Main.java --
import java.util.Collections;
import java.util.List;

public class Main {
    static class Box<K> {
        void put(K key) {
        }

        void put(K key, int n) {
        }
    }

    static void send() {
    }

    static void send(String s, int n) {
    }

    static void send(int n) {
    }

    static void send(Integer n) {
    }

    static void send(java.util.Date d) {
    }

    static void send(java.sql.Date d) {
    }

    static void send(byte[] b) {
    }

    static void send(String[][] s) {
    }

    static void send(List<String> l) {
    }

    static void send(String fmt, Object... rest) {
    }

    public static void main(String[] args) {
        send();
        send("a", 1);
        send(1);
        send(Integer.valueOf(2));
        send(new java.util.Date(0));
        send(new java.sql.Date(0));
        send(new byte[] {1});
        send(new String[][] {{"x"}});
        send(Collections.<String>emptyList());
        send("f", 1, 2);
        new Box<String>().put("k");
    }
}
-- spec.yaml --
probes:
  - id: all
    where: { class: Main, method: send, at: [entry] }
  - id: qualified
    where: { class: Main, method: send, params: [java.lang.String, int], at: [entry] }
  - id: simple
    where: { class: Main, method: send, params: [String, int], at: [entry] }
  - id: ambiguous
    where: { class: Main, method: send, params: [Date], at: [entry] }
  - id: empty
    where: { class: Main, method: send, params: [], at: [entry] }
  - id: primitive
    where: { class: Main, method: send, params: [int], at: [entry] }
  - id: boxed
    where: { class: Main, method: send, params: [Integer], at: [entry] }
  - id: arrays
    where: { class: Main, method: send, params: ['byte[]'], at: [entry] }
  - id: arrays2
    where: { class: Main, method: send, params: ['String[][]'], at: [entry] }
  - id: generic
    where: { class: Main, method: send, params: ['List<Order>'], at: [entry] }
  - id: varargs
    where: { class: Main, method: send, params: [String, Object...], at: [entry] }
  - id: typevar
    where: { class: 'Main$Box', method: put, params: [K], at: [entry] }
    what: [args]
  - id: nomatch
    where: { class: Main, method: send, params: [long], at: [entry] }
