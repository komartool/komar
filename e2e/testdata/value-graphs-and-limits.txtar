# cycles and shared objects use @id/@ref; depth, items, string and fields limits mark what was cut; spec-wide and per-probe limits merge per key
exec javac --release 8 -Xlint:-options -d classes Main.java
exec komar run spec.yaml -o out -- java -cp classes Main
jsonl-norm out.jsonl got.jsonl
cmp got.jsonl expected.jsonl

-- Main.java --
import java.util.ArrayList;
import java.util.List;

public class Main {
    static class Node {
        private String name;
        private Node next;
        private Node other;

        Node(String name) {
            this.name = name;
        }
    }

    static class Wide {
        private int a = 1;
        private int b = 2;
        private int c = 3;
    }

    static void graph(Node n) {
    }

    static void big(List<Integer> list, String text, Wide w) {
    }

    public static void main(String[] args) {
        Node a = new Node("a");
        Node b = new Node("b");
        a.next = b;
        b.next = a;
        a.other = b;
        graph(a);
        Node c1 = new Node("1");
        c1.next = new Node("2");
        c1.next.next = new Node("3");
        c1.next.next.next = new Node("4");
        graph(c1);
        List<Integer> list = new ArrayList<>();
        for (int i = 0; i < 5; i++) {
            list.add(i);
        }
        big(list, "abcdefgh", new Wide());
    }
}
-- spec.yaml --
limits: { items: 3, string: 4 }
probes:
  - id: graph
    where: { class: Main, method: graph, at: [entry] }
    what: [args]
  - id: big
    where: { class: Main, method: big, at: [entry] }
    limits: { fields: 2 }
    what: [args]
