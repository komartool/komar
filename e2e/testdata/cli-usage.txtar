# usage errors exit 2 with a usage line
exec-status 2 komar
stderr 'expected command "run"'
stderr '^usage: komar run'

exec-status 2 komar run spec.yaml -- java
stderr 'missing -o'

exec-status 2 komar run spec.yaml -o out
stderr 'missing program after --'

exec-status 2 komar run spec.yaml -o out -f -- java
stderr '-f needs a list of formats'

exec-status 2 komar run spec.yaml -o out -f jsonl,html -- java
stderr 'unknown format "html" in -f: use jsonl, view'

exec-status 2 komar run spec.yaml -o out -f , -- java
stderr '-f needs a list of formats'
