# komar run writes a compact view next to the dump: collaborator calls nested under the target, shared values labelled once, identical executions folded
exec javac --release 8 -Xlint:-options -g -parameters -d classes Main.java
exec komar run spec.yaml -o out.jsonl -- java -cp classes Main
exists out.komar
cmp out.komar expected.komar

exec komar run spec.yaml -o view.txt -- java -cp classes Main
exists view.komar

-- Main.java --
import java.util.HashMap;
import java.util.Map;

public class Main {
    static class Order {
        private final long id;
        private final String customer;
        private final String note;

        Order(long id, String customer) {
            this.id = id;
            this.customer = customer;
            this.note = null;
        }
    }

    static class Repo {
        private final Map<Long, String> tiers = new HashMap<>();

        Repo() {
            tiers.put(1L, "gold");
        }

        String tier(Order order) {
            return tiers.get(order.id);
        }
    }

    private final Repo repo = new Repo();

    double discount(Order order) {
        String tier = repo.tier(order);
        if (tier == null) {
            throw new IllegalArgumentException("unknown " + order.customer);
        }
        return 0.1;
    }

    public static void main(String[] args) {
        Main m = new Main();
        Order known = new Order(1, "ann-the-long-customer-name");
        for (int i = 0; i < 3; i++) {
            System.out.println(m.discount(known));
        }
        try {
            m.discount(new Order(2, "bob-the-long-customer-name"));
        } catch (IllegalArgumentException e) {
            System.out.println(e.getMessage());
        }
    }
}
-- spec.yaml --
probes:
  - id: discount
    where: { class: Main, method: discount, at: [entry, exit, exception] }
    what: [args, ret, exception.message]
  - id: repo
    where: { class: Main, method: discount, call: { class: 'Main$Repo', method: tier } }
    what: [call.args, ret]
-- expected.komar --
# → call made by the method above, ⇒ outcome, Type#n{…} first occurrence of a value, #n the same value again, =#n+{f: v} like #n except these fields (∅ = gone), ^n reference within one captured value, ×N repeated N times
hits: discount@entry 4, repo@before 4, repo@after 4, discount@exit 3, discount@exception 1
end: reason=exit code=0
executions: 4, distinct: 2

Main.discount(Order)  args=(Order#1{id: 1, customer: "ann-the-long-customer-name"})   ×3
  → Repo.tier(Order#1) ⇒ "gold"
  ⇒ 0.1

Main.discount(Order)  args=(Order#2{id: 2, customer: "bob-the-long-customer-name"})
  → Repo.tier(Order#2) ⇒ null
  ⇒ threw  exception.message="unknown bob-the-long-customer-name"
