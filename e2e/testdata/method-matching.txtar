# exact class names, wildcards, binary names of nested classes, static and private methods
exec javac --release 8 -Xlint:-options -d classes Main.java shop/OrderService.java shop/UserService.java shop/Repo.java other/Main.java
exec komar run spec.yaml -o out -- java -cp classes Main
jsonl-norm out.jsonl got.jsonl
cmp got.jsonl expected.jsonl

-- Main.java --
public class Main {
    static class Inner {
        int twice(int x) {
            return x * 2;
        }
    }

    private static int secret(int x) {
        return x + 1;
    }

    public static void main(String[] args) {
        new shop.OrderService().run();
        new shop.UserService().run();
        new shop.Repo().run();
        new other.Main().run();
        new Inner().twice(4);
        secret(1);
    }
}
-- shop/OrderService.java --
package shop;

public class OrderService {
    public void run() {
    }
}
-- shop/UserService.java --
package shop;

public class UserService {
    public void run() {
    }
}
-- shop/Repo.java --
package shop;

public class Repo {
    public void run() {
    }
}
-- other/Main.java --
package other;

public class Main {
    public void run() {
    }
}
-- spec.yaml --
probes:
  - id: services
    where: { class: 'shop.*Service', method: run, at: [entry] }
  - id: exact
    where: { class: Main, method: secret, at: [exit] }
    what: [ret]
  - id: other_not_matched
    where: { class: Main, method: run, at: [entry] }
  - id: nested
    where: { class: 'Main$Inner', method: twice, at: [exit] }
    what: [ret]
-- expected.jsonl --
