# a probe matching more classes than limits.classes is switched off with one diag; hits before that stay; other probes keep working
exec javac --release 8 -Xlint:-options -d classes Main.java
exec komar run spec.yaml -o out.jsonl -- java -cp classes Main
jsonl-norm out.jsonl got.jsonl
cmp got.jsonl expected.jsonl

-- Main.java --
public class Main {
    static class A {
        void run() {
        }
    }

    static class B {
        void run() {
        }
    }

    static class C {
        void run() {
        }
    }

    public static void main(String[] args) {
        new A().run();
        new B().run();
        new C().run();
        new A().run();
    }
}
-- spec.yaml --
probes:
  - id: wide
    where: { class: 'Main$*', method: run, at: [entry] }
    limits: { classes: 2 }
  - id: narrow
    where: { class: 'Main$A', method: run, at: [entry] }
-- expected.jsonl --
{"kind":"run","format":1,"komar":"<masked>","spec":"spec.yaml","cmd":["java","-cp","classes","Main"],"start":"<masked>"}
{"kind":"diag","level":"info","msg":"agent started","jvm":"<masked>","pid":1}
{"kind":"diag","level":"info","probe":"wide","msg":"placed","class":"Main$A","methods":1,"pid":1}
{"kind":"diag","level":"info","probe":"narrow","msg":"placed","class":"Main$A","methods":1,"pid":1}
{"kind":"hit","probe":"wide","point":"entry","method":"Main$A.run()","call":1,"parent":null,"thread":{"id":1,"name":"main"},"pid":1,"ts":"<masked>","what":{}}
{"kind":"hit","probe":"narrow","point":"entry","method":"Main$A.run()","call":1,"parent":null,"thread":{"id":1,"name":"main"},"pid":1,"ts":"<masked>","what":{}}
{"kind":"diag","level":"info","probe":"wide","msg":"placed","class":"Main$B","methods":1,"pid":1}
{"kind":"hit","probe":"wide","point":"entry","method":"Main$B.run()","call":2,"parent":null,"thread":{"id":1,"name":"main"},"pid":1,"ts":"<masked>","what":{}}
{"kind":"diag","level":"error","probe":"wide","msg":"probe switched off: its where matched 3 classes, more than limits.classes (2); narrow the class pattern or raise the limit","class":"Main$C","pid":1}
{"kind":"hit","probe":"narrow","point":"entry","method":"Main$A.run()","call":3,"parent":null,"thread":{"id":1,"name":"main"},"pid":1,"ts":"<masked>","what":{}}
{"kind":"end","reason":"exit","code":0,"hits":{"narrow":2,"wide":2},"dropped":0,"when_errors":{}}
