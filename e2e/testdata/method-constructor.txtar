# method: new captures args at entry and the built object at exit; params pick one constructor; this(...) chains write one exit per constructor; <init> is an alias
exec javac --release 8 -Xlint:-options -d classes Main.java
exec komar run spec.yaml -o out -- java -cp classes Main
jsonl-norm out.jsonl got.jsonl
cmp got.jsonl expected.jsonl

-- Main.java --
public class Main {
    static class Order {
        private final long id;
        private final String note;

        Order(long id) {
            this(id, "none");
        }

        Order(long id, String note) {
            this.id = id;
            this.note = note;
        }
    }

    public static void main(String[] args) {
        new Order(7);
    }
}
-- spec.yaml --
probes:
  - id: created
    where: { class: 'Main$Order', method: new, at: [entry, exit] }
    what: [args, this]
  - id: one_arg
    where: { class: 'Main$Order', method: '<init>', params: [long], at: [exit] }
-- expected.jsonl --
