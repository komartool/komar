{"kind":"diag","level":"info","probe":"one_arg","msg":"placed","class":"Main$Order","methods":1,"pid":1}
{"kind":"hit","probe":"created","point":"entry","method":"Main$Order.new(long)","call":1,"parent":null,"thread":{"id":1,"name":"main"},"pid":1,"ts":"<masked>","what":{"args":[7]}}
