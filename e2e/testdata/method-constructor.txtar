{"kind":"hit","probe":"created","point":"exit","method":"Main$Order.new(long, String)","call":2,"parent":1,"thread":{"id":1,"name":"main"},"pid":1,"ts":"<masked>","what":{"args":[7,"none"],"this":{"@type":"Main$Order","id":7,"note":"none"}}}
{"kind":"hit","probe":"created","point":"exit","method":"Main$Order.new(long)","call":1,"parent":null,"thread":{"id":1,"name":"main"},"pid":1,"ts":"<masked>","what":{"args":[7],"this":{"@type":"Main$Order","id":7,"note":"none"}}}
{"kind":"hit","probe":"one_arg","point":"exit","method":"Main$Order.new(long)","call":1,"parent":null,"thread":{"id":1,"name":"main"},"pid":1,"ts":"<masked>","what":{}}
