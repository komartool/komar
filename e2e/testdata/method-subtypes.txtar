{"kind":"hit","probe":"sizes","point":"exit","method":"Main$Sub.size()","call":3,"parent":null,"thread":{"id":1,"name":"main"},"pid":1,"ts":"<masked>","what":{"ret":2}}
{"kind":"diag","level":"error","probe":"interface_only","msg":"no method send matched in Main$Gateway; Main$Gateway is an interface or abstract class, use subtypes: true to probe implementations"}
