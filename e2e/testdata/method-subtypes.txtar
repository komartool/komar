# subtypes: true matches implementations (also one loaded late) and overriding subclasses; an interface without subtypes matches nothing and says why
exec javac --release 8 -Xlint:-options -d classes Main.java
exec komar run spec.yaml -o out -- java -cp classes Main
jsonl-norm out.jsonl got.jsonl
cmp got.jsonl expected.jsonl

-- Main.java --
public class Main {
    interface Gateway {
        String send(String msg);
    }

    static class Stripe implements Gateway {
        public String send(String msg) {
            return "stripe:" + msg;
        }
    }

    static class Paypal implements Gateway {
        public String send(String msg) {
            return "paypal:" + msg;
        }
    }

    static class Base {
        int size() {
            return 1;
        }
    }

    static class Sub extends Base {
        @Override
        int size() {
            return 2;
        }
    }

    public static void main(String[] args) throws Exception {
        Gateway g = new Stripe();
        g.send("a");
        Gateway late = (Gateway) Class.forName("Main$Paypal").getDeclaredConstructor().newInstance();
        late.send("b");
        new Sub().size();
    }
}
-- spec.yaml --
probes:
  - id: gateways
    where: { class: 'Main$Gateway', subtypes: true, method: send, at: [exit] }
    what: [ret]
  - id: sizes
    where: { class: 'Main$Base', subtypes: true, method: size, at: [exit] }
    what: [ret]
  - id: interface_only
    where: { class: 'Main$Gateway', method: send, at: [entry] }
-- expected.jsonl --
{"kind":"run","format":1,"komar":"<masked>","spec":"spec.yaml","cmd":["java","-cp","classes","Main"],"start":"<masked>"}
