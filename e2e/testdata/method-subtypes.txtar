{"kind":"diag","level":"info","probe":"gateways","msg":"placed","class":"Main$Paypal","methods":1,"pid":1}
{"kind":"hit","probe":"gateways","point":"exit","method":"Main$Paypal.send(String)","call":2,"parent":null,"thread":{"id":1,"name":"main"},"pid":1,"ts":"<masked>","what":{"ret":"paypal:b"}}
{"kind":"diag","level":"info","probe":"sizes","msg":"placed","class":"Main$Sub","methods":1,"pid":1}
