# a when using a value missing at a point warns before launch and never fires there; other points still fire
exec javac --release 8 -Xlint:-options -d classes Main.java
exec komar run spec.yaml -o out.jsonl -- java -cp classes Main
stderr 'komar: warning: spec.yaml:4:11: probe "nulls": when uses ret, not available at entry; entry will never fire'
stderr 'komar: warning: spec.yaml:8:11: probe "slow": when uses duration, not available at entry; entry will never fire'
stderr 'komar: warning: spec.yaml:12:11: probe "errs": when uses exception, not available at exit; exit will never fire'
jsonl-norm out.jsonl got.jsonl
cmp got.jsonl expected.jsonl

-- Main.java --
public class Main {
    static String find(int id) {
        if (id < 0) {
            throw new IllegalArgumentException("bad id " + id);
        }
        return id == 0 ? null : "item" + id;
    }

    public static void main(String[] args) {
        find(0);
        find(1);
        try {
            find(-1);
        } catch (IllegalArgumentException e) {
            System.out.println("caught");
        }
    }
}
-- spec.yaml --
probes:
  - id: nulls
    where: { class: Main, method: find, at: [entry, exit] }
    when: 'ret == null'
    what: [args]
  - id: slow
    where: { class: Main, method: find, at: [entry, exit] }
    when: 'duration >= 0'
    what: [args]
  - id: errs
    where: { class: Main, method: find, at: [exit, exception] }
    when: 'exception.message.startsWith("bad")'
    what:
      - msg: exception.message
-- expected.jsonl --
