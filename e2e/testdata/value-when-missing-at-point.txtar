{"kind":"diag","level":"warn","probe":"nulls","msg":"spec.yaml:4:11: probe \"nulls\": when uses ret, not available at entry; entry will never fire"}
{"kind":"diag","level":"warn","probe":"slow","msg":"spec.yaml:8:11: probe \"slow\": when uses duration, not available at entry; entry will never fire"}
{"kind":"diag","level":"warn","probe":"errs","msg":"spec.yaml:12:11: probe \"errs\": when uses exception, not available at exit; exit will never fire"}
{"kind":"diag","level":"info","msg":"agent started","jvm":"<masked>","pid":1}
{"kind":"diag","level":"info","probe":"nulls","msg":"placed","class":"Main","methods":1,"pid":1}
{"kind":"diag","level":"info","probe":"slow","msg":"placed","class":"Main","methods":1,"pid":1}
{"kind":"diag","level":"info","probe":"errs","msg":"placed","class":"Main","methods":1,"pid":1}
{"kind":"hit","probe":"nulls","point":"exit","method":"Main.find(int)","call":1,"parent":null,"thread":{"id":1,"name":"main"},"pid":1,"ts":"<masked>","what":{"args":[0]}}
{"kind":"hit","probe":"slow","point":"exit","method":"Main.find(int)","call":1,"parent":null,"thread":{"id":1,"name":"main"},"pid":1,"ts":"<masked>","what":{"args":[0]}}
{"kind":"hit","probe":"slow","point":"exit","method":"Main.find(int)","call":2,"parent":null,"thread":{"id":1,"name":"main"},"pid":1,"ts":"<masked>","what":{"args":[1]}}
{"kind":"hit","probe":"errs","point":"exception","method":"Main.find(int)","call":3,"parent":null,"thread":{"id":1,"name":"main"},"pid":1,"ts":"<masked>","what":{"msg":"bad id -1"}}
