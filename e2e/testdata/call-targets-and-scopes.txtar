# JDK callees are observed without instrumenting the JDK; params select a callee overload; call sites inside lambdas and anonymous classes fire; callees get no records of their own; a call-site record's call is the parent of the callee's method record
exec javac --release 8 -Xlint:-options -g -d classes Main.java
exec komar run spec.yaml -o out.jsonl -- java -cp classes Main
jsonl-norm out.jsonl got.jsonl
cmp got.jsonl expected.jsonl

-- Main.java --
import java.util.Arrays;
import java.util.HashMap;
import java.util.Map;

public class Main {
    static void send(int n) {
    }

    static void send(String s) {
    }

    static int helper(int x) {
        return x + 1;
    }

    static void handle(Map<String, Integer> map) {
        map.get("a");
        send(1);
        send("one");
        Arrays.asList(1, 2).forEach(x -> {
            int y = helper(x);
        });
        Runnable r = new Runnable() {
            @Override
            public void run() {
                helper(10);
            }
        };
        r.run();
    }

    public static void main(String[] args) {
        Map<String, Integer> map = new HashMap<>();
        map.put("a", 7);
        handle(map);
    }
}
-- spec.yaml --
probes:
  - id: jdk_get
    where: { class: Main, method: handle, call: { class: java.util.HashMap, method: get }, at: [after] }
    what: [call.args, ret]
  - id: send_int
    where: { class: Main, method: handle, call: { class: Main, method: send, params: [int] }, at: [before] }
    what: [call.args]
  - id: send_all
    where: { class: Main, method: handle, call: { class: Main, method: send }, at: [before] }
    what: [call.args]
  - id: nested
    where: { class: Main, method: handle, call: { class: Main, method: helper }, at: [after] }
    what:
      - x: call.args[0]
      - ret: ret
  - id: helper_entry
    where: { class: Main, method: helper, at: [entry] }
    what: [args]
-- expected.jsonl --
