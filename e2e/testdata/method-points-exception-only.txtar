# at: [exception] writes only for calls that throw
exec javac --release 8 -Xlint:-options -d classes Main.java
exec komar run spec.yaml -o out -- java -cp classes Main
jsonl-norm out.jsonl got.jsonl
cmp got.jsonl expected.jsonl

-- Main.java --
public class Main {
    static int check(int x) {
        if (x < 0) {
            throw new IllegalArgumentException("negative: " + x);
        }
        return x * 2;
    }

    public static void main(String[] args) {
        for (int x : new int[] {1, -2, 3, -4}) {
            try {
                check(x);
            } catch (IllegalArgumentException e) {
                System.out.println("caught");
            }
        }
    }
}
-- spec.yaml --
probes:
  - id: check
    where: { class: Main, method: check, at: [exception] }
    what: [args, exception]
-- expected.jsonl --
{"kind":"run","format":1,"komar":"<masked>","spec":"spec.yaml","cmd":["java","-cp","classes","Main"],"start":"<masked>"}
{"kind":"diag","level":"info","msg":"agent started","jvm":"<masked>","pid":1}
{"kind":"diag","level":"info","probe":"check","msg":"placed","class":"Main","methods":1,"pid":1}
{"kind":"hit","probe":"check","point":"exception","method":"Main.check(int)","call":1,"parent":null,"thread":{"id":1,"name":"main"},"pid":1,"ts":"<masked>","what":{"args":[-2],"exception":{"@type":"java.lang.IllegalArgumentException","message":"negative: -2"}}}
{"kind":"hit","probe":"check","point":"exception","method":"Main.check(int)","call":2,"parent":null,"thread":{"id":1,"name":"main"},"pid":1,"ts":"<masked>","what":{"args":[-4],"exception":{"@type":"java.lang.IllegalArgumentException","message":"negative: -4"}}}
{"kind":"end","reason":"exit","code":0,"hits":{"check":2},"dropped":0,"when_errors":{}}
