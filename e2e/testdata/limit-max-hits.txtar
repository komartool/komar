# a probe stops firing after max_hits, says so once, and end counts only the written hits
exec javac --release 8 -Xlint:-options -d classes Main.java
exec komar run spec.yaml -o out -- java -cp classes Main
jsonl-norm out.jsonl got.jsonl
cmp got.jsonl expected.jsonl

-- Main.java --
public class Main {
    static void tick(int i) {
    }

    public static void main(String[] args) {
        for (int i = 0; i < 10; i++) {
            tick(i);
        }
    }
}
-- spec.yaml --
probes:
  - id: tick
    where: { class: Main, method: tick, at: [entry] }
    limits: { max_hits: 3 }
    what: [args]
-- expected.jsonl --
{"kind":"run","format":1,"komar":"<masked>","spec":"spec.yaml","cmd":["java","-cp","classes","Main"],"start":"<masked>"}
{"kind":"diag","level":"info","msg":"agent started","jvm":"<masked>","pid":1}
{"kind":"diag","level":"info","probe":"tick","msg":"placed","class":"Main","methods":1,"pid":1}
{"kind":"hit","probe":"tick","point":"entry","method":"Main.tick(int)","call":1,"parent":null,"thread":{"id":1,"name":"main"},"pid":1,"ts":"<masked>","what":{"args":[0]}}
{"kind":"hit","probe":"tick","point":"entry","method":"Main.tick(int)","call":2,"parent":null,"thread":{"id":1,"name":"main"},"pid":1,"ts":"<masked>","what":{"args":[1]}}
{"kind":"hit","probe":"tick","point":"entry","method":"Main.tick(int)","call":3,"parent":null,"thread":{"id":1,"name":"main"},"pid":1,"ts":"<masked>","what":{"args":[2]}}
{"kind":"diag","level":"warn","probe":"tick","msg":"max_hits reached; probe stopped","pid":1}
{"kind":"end","reason":"exit","code":0,"hits":{"tick":3},"dropped":0,"when_errors":{}}
