# entry carries args, exit carries args and ret; both share one call id; program output is unchanged
exec javac --release 8 -Xlint:-options -d classes Main.java
exec java -cp classes Main
cp stdout base.txt
exec komar run spec.yaml -o out -- java -cp classes Main
cmp stdout base.txt
jsonl-norm out.jsonl got.jsonl
cmp got.jsonl expected.jsonl

-- Main.java --
public class Main {
    int add(int a, int b) {
        return a + b;
    }

    public static void main(String[] args) {
        Main m = new Main();
        System.out.println(m.add(1, 2));
        System.out.println(m.add(3, 4));
    }
}
-- spec.yaml --
probes:
  - id: add
    where: { class: Main, method: add, at: [entry, exit] }
    what: [args, ret]
-- expected.jsonl --
{"kind":"run","format":1,"komar":"<masked>","spec":"spec.yaml","cmd":["java","-cp","classes","Main"],"start":"<masked>"}
{"kind":"diag","level":"info","msg":"agent started","jvm":"<masked>","pid":1}
{"kind":"diag","level":"info","probe":"add","msg":"placed","class":"Main","methods":1,"pid":1}
{"kind":"hit","probe":"add","point":"entry","method":"Main.add(int, int)","call":1,"parent":null,"thread":{"id":1,"name":"main"},"pid":1,"ts":"<masked>","what":{"args":[1,2]}}
{"kind":"hit","probe":"add","point":"exit","method":"Main.add(int, int)","call":1,"parent":null,"thread":{"id":1,"name":"main"},"pid":1,"ts":"<masked>","what":{"args":[1,2],"ret":3}}
{"kind":"hit","probe":"add","point":"entry","method":"Main.add(int, int)","call":2,"parent":null,"thread":{"id":1,"name":"main"},"pid":1,"ts":"<masked>","what":{"args":[3,4]}}
{"kind":"hit","probe":"add","point":"exit","method":"Main.add(int, int)","call":2,"parent":null,"thread":{"id":1,"name":"main"},"pid":1,"ts":"<masked>","what":{"args":[3,4],"ret":7}}
{"kind":"end","reason":"exit","code":0,"hits":{"add":4},"dropped":0,"when_errors":{}}
